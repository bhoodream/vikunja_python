# Vikunja CLI Configuration

# URL of your Vikunja instance (e.g., https://vikunja.example.com)
VIKUNJA_URL=https://try.vikunja.io

# Your API Token (generate in Settings -> API Tokens)
VIKUNJA_TOKEN=your_api_token_here

# (Optional) Default project ID or title, or 'all' to show all projects
# VIKUNJA_PROJECT=all
